{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "gg.velaccio.assettolauncher",
  "applicationName": "Assetto Launcher",
  "version": "0.2.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "server.*",
    "storage.*",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "Assetto Launcher",
      "width": 1540,
      "height": 795,
      "minWidth": 1540,
      "minHeight": 795,
      "center": true,
      "borderless": true,
      "resizable": true,
      "enableInspector": false,
      "exitProcessOnClose": true,
      "icon": "/resources/img/icon.png"
    }
  },
  "cli": {
    "binaryName": "assetto-launcher",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
